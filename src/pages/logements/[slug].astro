---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Calendar from '../../components/Calendar.astro';
import Carousel from '../../components/Carousel.astro';
import { getLogementBySlug, getPhotos, getOccupations } from '../../lib/db';
import { useTranslations, type Lang, ui } from '../../i18n/ui';
import { parseEquipements, urlPhoto } from '../../lib/format';

const lang = (Astro.currentLocale as Lang) ?? 'fr';
const t = useTranslations(lang);
const DB = Astro.locals.runtime.env.DB;

const { slug } = Astro.params;
const logement = slug ? await getLogementBySlug(DB, slug) : null;

// 404 si introuvable ou masque.
if (!logement || logement.statut === 'masque') {
  return new Response(null, { status: 404, statusText: 'Logement introuvable' });
}

const [photos, occupations] = await Promise.all([
  getPhotos(DB, logement.id),
  getOccupations(DB, logement.id),
]);

const equipements = parseEquipements(logement.equipements);
const brouillon = logement.statut === 'brouillon';

// Icone associee a chaque code d'equipement.
const iconeEquip: Record<string, string> = {
  wifi: 'wifi', parking_garage: 'car', parking: 'car', lave_vaisselle: 'dish', lave_linge_partage: 'wash',
  cheminee_poele: 'fire', television: 'tv', casier_skis: 'ski', balcon: 'balcony',
  vue_montagne: 'eye', animaux_acceptes: 'paw', borne_recharge: 'plug',
};
const libelleEquip = (code: string) =>
  (ui[lang] as Record<string, string>)[`equip.${code}`] ?? (ui.fr as Record<string, string>)[`equip.${code}`] ?? code;

const couverture = photos.find((p) => p.est_couverture) ?? photos[0];
const description = logement.description_courte ?? `${logement.nom} à Châtel`;

// Donnees structurees Schema.org : location de vacances.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VacationRental',
  name: logement.nom,
  description: logement.description_courte,
  url: new URL(Astro.url.pathname, Astro.site).href,
  numberOfRooms: logement.nb_chambres,
  occupancy: { '@type': 'QuantitativeValue', maxValue: logement.capacite_max },
  ...(logement.surface_m2 ? { floorSize: { '@type': 'QuantitativeValue', value: logement.surface_m2, unitCode: 'MTK' } } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: logement.adresse,
    addressLocality: 'Châtel',
    postalCode: '74390',
    addressCountry: 'FR',
  },
  ...(logement.latitude && logement.longitude
    ? { geo: { '@type': 'GeoCoordinates', latitude: logement.latitude, longitude: logement.longitude } }
    : {}),
  image: couverture ? new URL(urlPhoto(couverture.url_r2), Astro.site).href : undefined,
  amenityFeature: equipements.map((code) => ({
    '@type': 'LocationFeatureSpecification', name: libelleEquip(code), value: true,
  })),
};
---
<Base titre={logement.nom} description={description} image={couverture?.url_r2} jsonLd={jsonLd} noindex={brouillon}>
  <div class="conteneur">
    <nav class="ariane" aria-label="Fil d'Ariane">
      <a href="/">{t('nav.accueil')}</a> ·
      <a href="/logements">{t('nav.logements')}</a> ·
      <span>{logement.nom}</span>
    </nav>

    {photos.length > 0 && (
      <Carousel photos={photos.map((p) => ({ src: urlPhoto(p.url_r2), alt: p.texte_alt ?? logement.nom }))} />
    )}

    <div class="fiche__entete">
      {logement.adresse && (
        <span class="fiche__lieu"><Icone nom="map" /> {logement.adresse}</span>
      )}
      <h1>{logement.nom}</h1>
    </div>
    {brouillon && <div class="alerte" style="margin-bottom:1rem">{t('fiche.brouillon')} — informations à confirmer par le propriétaire.</div>}

    <div class="fiche__layout fiche">
      <div>
        <ul class="specs">
          <li><Icone nom="users" /> {logement.capacite_max} {t('liste.personnes')}</li>
          <li><Icone nom="bed" /> {logement.nb_chambres} {t('liste.chambres')}</li>
          <li><Icone nom="bath" /> {logement.nb_sdb} {t('liste.sdb')}</li>
          {logement.surface_m2 && <li><Icone nom="ruler" /> {logement.surface_m2} m²</li>}
          {logement.altitude && <li><Icone nom="altitude" /> {logement.altitude} m</li>}
        </ul>

        {logement.description_longue && (
          <section style="margin-top:1.5rem">
            <h2>{t('fiche.description')}</h2>
            {logement.description_longue.split('\n\n').map((para) => <p>{para}</p>)}
          </section>
        )}

        {equipements.length > 0 && (
          <section style="margin-top:1.5rem">
            <h2>{t('fiche.equipements')}</h2>
            <ul class="equipements">
              {equipements.map((code) => (
                <li><Icone nom={iconeEquip[code] ?? 'check'} /> {libelleEquip(code)}</li>
              ))}
            </ul>
          </section>
        )}

        <section style="margin-top:1.8rem">
          <h2>{t('fiche.calendrier')}</h2>
          <Calendar occupations={occupations} />
        </section>

        {logement.adresse && (
          <section style="margin-top:1.8rem">
            <h2>{t('fiche.localisation')}</h2>
            <p><Icone nom="map" /> {logement.adresse}</p>
            <a class="btn btn--sapin" target="_blank" rel="noopener"
               href={`https://www.openstreetmap.org/?mlat=${logement.latitude}&mlon=${logement.longitude}#map=15/${logement.latitude}/${logement.longitude}`}>
              Voir sur la carte
            </a>
          </section>
        )}
      </div>

      <aside>
        <div class="encadre encadre--sticky">
          <p class="encadre__titre">Réserver ce logement</p>
          <p class="note" style="margin:0 0 1rem">Disponibilités et tarifs en temps réel lors de la réservation.</p>

          <ul class="puces" style="margin:0 0 1.2rem;font-size:.94rem">
            <li><Icone nom="users" /> Jusqu’à {logement.capacite_max} personnes</li>
            <li><Icone nom="bed" /> {logement.nb_chambres} chambres · {logement.nb_sdb} salle(s) d’eau</li>
            <li><Icone nom="bouclier" /> Réservation directe auprès des propriétaires</li>
          </ul>

          <a href={`/reserver?logement=${logement.slug}`} class="btn btn--primaire btn--bloc">
            {t('fiche.reserver')} <Icone nom="fleche" />
          </a>
          <a href={`/contact?logement=${logement.slug}`} class="btn btn--doux btn--bloc" style="margin-top:.6rem">
            <Icone nom="courriel" /> {t('nav.contact')}
          </a>

          {logement.numero_enregistrement_meuble && (
            <p class="note" style="margin:1.1rem 0 0">{t('fiche.numero_meuble')} : <strong>{logement.numero_enregistrement_meuble}</strong></p>
          )}
        </div>
      </aside>
    </div>

    <p style="margin:2rem 0"><a href="/logements">← {t('fiche.retour')}</a></p>
  </div>
</Base>
