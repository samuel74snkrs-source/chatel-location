---
import Base from '../layouts/Base.astro';
---
<Base titre="Politique de confidentialité" description="Politique de confidentialité et protection des données (RGPD) — Châtel Appartements." noindex>
  <section class="section">
    <div class="conteneur" style="max-width:720px">
      <h1>Politique de confidentialité</h1>
      <div class="alerte">Contenu à finaliser (RGPD — voir cahier des charges §8).</div>
      <h2>Données collectées</h2>
      <p>Les données saisies dans le formulaire de demande de réservation (nom, e-mail, téléphone, dates) sont utilisées uniquement pour traiter votre demande.</p>
      <h2>Conservation et suppression</h2>
      <p>Vous pouvez demander la suppression de vos données à tout moment en nous contactant.</p>
      <h2>Cookies</h2>
      <p>Le site n’utilise pas de cookies de suivi publicitaire.</p>
    </div>
  </section>
</Base>
